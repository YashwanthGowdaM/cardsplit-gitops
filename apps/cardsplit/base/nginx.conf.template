# -----------------------------------------------------------------------------
# CardSplit - Nginx config for KUBERNETES.
# Mounted over /etc/nginx/templates/default.conf.template by the frontend
# Deployment (ConfigMap "frontend-nginx"). The official nginx image renders
# ${BACKEND_HOST} and ${BACKEND_PORT} from environment variables at start-up.
#
# Differences from the docker-compose version in the app repo:
#   * resolver points at the cluster DNS (kube-dns) instead of Docker's 127.0.0.11
#   * BACKEND_HOST must be a fully-qualified service name (nginx resolver does
#     not use the pod's DNS search domains)
# Trace headers (traceparent / x-request-id ...) are forwarded automatically by
# proxy_pass, so Istio/Jaeger can stitch frontend -> backend spans together.
# -----------------------------------------------------------------------------
server {
    listen 80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    client_max_body_size 50m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;

    resolver kube-dns.kube-system.svc.cluster.local valid=10s ipv6=off;

    location /api/ {
        set $backend_upstream http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_pass         $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location ~* \.mjs$ {
        default_type application/javascript;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /fonts/ {
        expires 30d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
